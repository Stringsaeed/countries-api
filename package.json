{
  "name": "countries-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --import tsx --test tests/publish.node.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run api:check && npm test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types": "wrangler types --strict-vars=false",
    "build": "wrangler deploy --dry-run --outdir dist",
    "data:download": "tsx scripts/download-data.ts",
    "data:build": "tsx scripts/build-data.ts",
    "data:publish": "tsx scripts/publish-data.ts",
    "deploy": "tsx alchemy.run.ts",
    "deploy:staging": "tsx alchemy.run.ts --stage staging",
    "prepare": "husky",
    "data:smoke": "npm run build && tsx scripts/smoke-data.ts",
    "api:generate": "tsx scripts/generate-openapi.ts",
    "api:check": "tsx scripts/generate-openapi.ts --check",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "deploy:verify": "tsx scripts/verify-deployment.ts"
  },
  "dependencies": {
    "cbor": "10.0.12",
    "cldr-localenames-full": "48.2.0",
    "effect": "4.0.0",
    "hono": "4.13.12",
    "negotiator": "1.1.0",
    "node-app-attest": "1.0.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1145.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/negotiator": "0.6.5",
    "@types/node": "26.6.3",
    "@types/yauzl": "3.4.0",
    "alchemy": "0.94.0",
    "dotenv": "18.0.5",
    "eslint": "10.11.0",
    "husky": "9.1.7",
    "miniflare": "4.20260730.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11",
    "wrangler": "4.146.0",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "undici": "7.30.0",
    "sharp": "0.35.5"
  }
}
