{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "countries-api-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "local",
    "APPLE_APP_ID_PREFIX": "UNCONFIGURED",
    "APPLE_BUNDLE_ID": "UNCONFIGURED",
    "DATASET_VERSION": "unconfigured",
  },
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "countries-api-local-data" }],
  "d1_databases": [
    {
      "binding": "SEARCH",
      "database_name": "countries-api-local-search",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "durable_objects": { "bindings": [{ "name": "APP_ATTEST", "class_name": "AppAttestDevice" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppAttestDevice"] }],
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "DATA_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
  ],
}
