CLOUDFLARE_ACCOUNT_ID=replace-with-your-account-id
CLOUDFLARE_API_TOKEN=replace-with-a-scoped-deployment-token
R2_ACCESS_KEY_ID=replace-with-your-bucket-scoped-s3-access-key
R2_SECRET_ACCESS_KEY=replace-with-your-bucket-scoped-s3-secret
ALCHEMY_STATE_TOKEN=replace-with-a-long-random-shared-state-token
ALCHEMY_PASSWORD=replace-with-a-long-random-state-encryption-password
APPLE_APP_ID_PREFIX=replace-with-your-10-character-app-id-prefix
APPLE_BUNDLE_ID=com.example.yourapp
# Android remains disabled until both the certificate allowlist and secret are set.
ANDROID_PACKAGE_NAME=sh.saeed.azkarify
# Comma-separated base64url SHA-256 digests of Play app-signing certificates.
ANDROID_CERTIFICATE_SHA256=
# Single-line service-account JSON. Server secret; never put this in the app.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Production domain. Requires an active Cloudflare zone.
API_DOMAIN=api.saeed.sh
# Staging domain. Requires an active Cloudflare zone.
STAGING_API_DOMAIN=staging.api.saeed.sh
